{
	local_certs
}

lab.internal {
	header /.well-known/matrix/* Content-Type application/json
	header /.well-known/matrix/* Access-Control-Allow-Origin *
	respond /.well-known/matrix/server `{"m.server":"matrix.lab.internal:443"}`
	respond /.well-known/matrix/client `{"m.homeserver":{"base_url":"https://matrix.lab.internal"}}`
}

matrix.lab.internal {
	reverse_proxy /_matrix/* synapse:8008
	reverse_proxy /_synapse/client/* synapse:8008
}

element.lab.internal {
	reverse_proxy element:80
}

ooye.lab.internal {
	reverse_proxy ooye:6693
}

rtc.lab.internal {
	handle /livekit/jwt* {
		uri strip_prefix /livekit/jwt
		reverse_proxy lk-jwt:8080
	}
	handle /livekit/sfu* {
		uri strip_prefix /livekit/sfu
		reverse_proxy livekit:7880
	}
}
